NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
# Set to the exact number (0–3) of trusted reverse proxies in front of the API.
TRUST_PROXY_HOPS=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=influencer_marketing
DB_USER=influencer_app
DB_PASSWORD=
# Module 2 will require independently generated access and refresh secrets.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=influencer-marketing
JWT_AUDIENCE=influencer-web
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
RESET_TOKEN_MINUTES=30
BCRYPT_ROUNDS=12
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Module 09 Task 1: Test Mode only. Never use rzp_live keys here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# At least 20 characters; use the same secret in the Test Mode webhook settings.
RAZORPAY_WEBHOOK_SECRET=
